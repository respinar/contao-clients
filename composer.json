{
    "name": "respinar/contao-clients",
    "description": "Contao Clients Bundle",
    "keywords": ["contao", "bundle", "clients"],
    "type": "contao-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Hamid Peywasti",
            "email": "hamid@respinar.com",
            "homepage": "https://respinar.com/",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/respinar/contao-clients/issues",
        "source": "https://github.com/respinar/contao-clients"
    },
    "require": {
        "php": "^8.3",
        "contao/core-bundle": "^5.7",
        "respinar/contao-company": "self.version"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.12"
    },
    "autoload": {
        "psr-4": {
            "Respinar\\ClientsBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Respinar\\ClientsBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Respinar\\ClientsBundle\\ContaoManager\\Plugin"
    }
}
